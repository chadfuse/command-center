# Copy this file to .dev.vars and fill in your real values.
# .dev.vars is NOT committed to Git and is only used by wrangler dev.
#
# Google AI Studio API key (get free key at https://aistudio.google.com):
# GOOGLE_API_KEY is used for Gemini text generation and Imagen image generation.
GOOGLE_API_KEY=AIzaSy...
# Alternatively, TEXT_API_KEY works as well:
# TEXT_API_KEY=AIzaSy...

# Optional overrides (defaults are in wrangler.toml):
# TEXT_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# TEXT_MODEL=gemini-2.5-flash
# FALLBACK_TEXT_MODEL=gemini-2.0-flash
# IMAGE_MODEL=imagen-3.0-generate-002
# FALLBACK_IMAGE_MODEL=imagen-3.0-fast-generate-001

# WordPress credentials for testing (also needed in .dev.vars).
# In production, set WP_APP_PASSWORD with `wrangler secret put WP_APP_PASSWORD`.
WP_URL=https://yourblog.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=XXXX XXXX XXXX XXXX XXXX
WP_STATUS=draft
